# ==============================================================================
# E-COMMERCE MICROSERVICES - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CATALOG SERVICE (MongoDB Atlas)
# Ví dụ: mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/CatalogDb?retryWrites=true&w=majority
# ------------------------------------------------------------------------------
CATALOG_DB_CONN=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/CatalogDb?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. BASKET SERVICE (PostgreSQL ngoài: Supabase + Upstash Redis)
# - Postgres format: Host=...;Port=5432;Database=...;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true
# - Redis format: endpoint:port,password=...,ssl=True,abortConnect=False
# ------------------------------------------------------------------------------
BASKET_DB_CONN=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxx;Password=your_pass;SSL Mode=Require;Trust Server Certificate=true
REDIS_CONN=your-endpoint.upstash.io:6379,password=your_upstash_pass,ssl=True,abortConnect=False

# ------------------------------------------------------------------------------
# 3. DISCOUNT SERVICE (SQLite cục bộ)
# ------------------------------------------------------------------------------
DISCOUNT_DB_CONN=Data Source=discountdb
DISCOUNT_GRPC_URL=https://discount.grpc:8081

# ------------------------------------------------------------------------------
# 4. ORDERING SERVICE (Aiven MySQL)
# Format chuẩn Pomelo MySQL .NET: Server=...;Port=...;Database=...;User=...;Password=...;SslMode=Required;
# ------------------------------------------------------------------------------
ORDERING_DB_CONN=Server=mysql-xxxx.aivencloud.com;Port=12345;Database=defaultdb;User=avnadmin;Password=your_password;SslMode=Required;

# ------------------------------------------------------------------------------
# 5. MESSAGE BROKER - RABBITMQ (MassTransit Bus)
# Mặc định dùng local container; nếu có CloudAMQP thì điền vào đây (host dạng amqps://...)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=amqp://ecommerce-mq:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 6. API GATEWAY & CLIENT (Next.js Shopping Client)
# ------------------------------------------------------------------------------
API_GATEWAY_URL=http://yarpapigateway:8080
CLIENT_PORT=3000
